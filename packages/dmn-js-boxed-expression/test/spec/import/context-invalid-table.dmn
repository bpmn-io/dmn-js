<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions_invalid" name="Invalid" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="Decision_1" name="Invalid">
    <context id="Context_1">
      <contextEntry id="ContextEntry_1">
        <variable id="Variable_1" name="first" />
        <decisionTable id="DecisionTable_1">
          <input id="Input_1">
            <inputExpression id="InputExpression_1" typeRef="string">
              <text>foo</text>
            </inputExpression>
          </input>
          <output id="Output_1" name="foo" typeRef="string" />
        </decisionTable>
      </contextEntry>
      <contextEntry id="ContextEntry_2">
        <variable id="Variable_2" name="second" />
        <decisionTable id="DecisionTable_2">
          <input id="Input_2">
            <inputExpression id="InputExpression_2" typeRef="string">
              <text>bar</text>
            </inputExpression>
          </input>
        </decisionTable>
      </contextEntry>
    </context>
  </decision>
</definitions>
