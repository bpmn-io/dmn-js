    <inputDecision href="model.dmn#Decision_Required" />
    <inputData href="model.dmn#InputData_Required" />
  </decisionService>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_Decision_Required" dmnElementRef="Decision_Required">
